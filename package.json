{
  "name": "pixel-rave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A pixel rave that streams CC-licensed chiptune and makes the crowd & lights react to it. Sibling experiment to Antfarm.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:itch": "tsc && vite build --mode itch && node -e \"const fs=require('fs');fs.rmSync('dist-itch/media',{recursive:true,force:true});fs.rmSync('dist-itch/sw.js',{force:true});fs.rmSync('dist-itch/manifest.webmanifest',{force:true});\"",
    "preview": "vite preview --host 0.0.0.0",
    "preview:itch": "vite preview --mode itch --port 5199"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  }
}
