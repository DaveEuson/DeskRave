node_modules
dist
*.local
.DS_Store

# server-side profile store
.data

# design-handoff package (kept locally as the wave-2 porting reference, not committed)
*.zip
_design_handoff/

# debug screenshots + camera captures pulled off devices (never commit)
jetson-shot*.png
